# Front (Render Static Site)
VITE_SUPABASE_URL=https://SEU_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui

# PIX da calculadora pública (#/rota) — QR e copia-e-cola
# VITE_PIX_CHAVE=553591368282
# VITE_PIX_NOME=DOCA LIVRE
# VITE_PIX_CIDADE=POUSO ALEGRE
#
# Login Google da calculadora (créditos na conta):
# 1) Supabase Dashboard → Authentication → Providers → Google (ligar)
# 2) Redirect URLs: https://ofertadecarga.com.br/  e  http://localhost:5173/
# 3) SQL: supabase/rota_publico_creditos.sql

# Pedágio/rota: Dados Abertos ANTT (gratuito) + OSRM — sem token.
# https://dados.antt.gov.br/dataset/praca-de-pedagio

# Web Push — alerta no celular do transportador ao publicar carga
# VITE_VAPID_PUBLIC_KEY=BFKZYtfv2pBOtsLnRcg0u2bcmNAxY9f86jsnU_XEKNEv11GlShJNPaR8ysWrsjw8Z8svjn2TsWTwEhmbjCY9qvA
#
# No Supabase:
# 1) SQL: supabase/push_subscriptions.sql
# 2) Secrets: VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT=mailto:diego@docalivre.com
# 3) Deploy: supabase functions deploy web-push
# 4) Mapa público (2 buscas grátis por IP): SQL supabase/mapa_publico_cotas.sql
#    e `supabase functions deploy mapa-publico-busca`
# Transportador: instalar PWA + “Ativar alertas” no banner.

# Secrets da Edge Function portal-otp (Dashboard — NÃO no front):
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Doca Livre Oferta de Carga <onboarding@resend.dev>
# PORTAL_OTP_SECRET=string-longa-aleatoria
# PORTAL_OTP_DEBUG=0
